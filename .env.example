# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=generate-with-openssl-rand-base64-32
# On Vercel set these to the live URL (not localhost):
# AUTH_URL=https://safari-hub-beta.vercel.app
# NEXT_PUBLIC_APP_URL=https://safari-hub-beta.vercel.app

# Same naming as intern attachment system
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Pooler URI (port 6543) + session URI (port 5432). URL-encode special chars in password (@ → %40)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Email — Gmail SMTP (same as Trace). Use an App Password, not your normal Gmail password.
# When set, Admin → Email can leave SMTP host blank (provider = SMTP).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Local testing: always-valid OTP (default 000000). Disabled in production unless OTP_ALLOW_TEST_CODE=true.
# OTP_TEST_CODE=000000
# OTP_ALLOW_TEST_CODE=false

# Optional: Resend instead of SMTP (also configurable in Admin → Settings → Email)
# RESEND_API_KEY=
# RESEND_FROM=Safari Hub <onboarding@resend.dev>
