{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/api/cron/complete-bookings",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/etims-submit",
      "schedule": "15 */6 * * *"
    }
  ]
}
